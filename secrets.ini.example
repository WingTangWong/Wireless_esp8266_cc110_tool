; Copy this file to secrets.ini (git-ignored) and fill in real values.
;   cp secrets.ini.example secrets.ini
;
; secrets.ini overrides the placeholder sections in platformio.ini via
; `extra_configs`. Values are injected as compile-time defines.
;
; Both firmwares are built from this one file, so the main unit and the remote
; end up sharing ap_ssid / ap_pass and are paired by default.
;
; Do NOT commit secrets.ini.

[wifi]
; 2.4 GHz network the main unit joins (station mode). The remote does NOT use
; these - it joins the main unit's SoftAP.
sta_ssid = your-2g4-network
sta_pass = your-wifi-password

; The main unit's SoftAP. The actual SSID is "<ap_ssid>-<chipId>". ap_pass must
; be >= 8 chars (WPA2), or empty for an open AP (not recommended). The remote
; joins this AP with this same password.
ap_ssid = cc1101-setup
ap_pass = pick-a-strong-passphrase

[remote]
; Leave target_ssid empty to have the remote join the strongest
; "cc1101-setup-*" it can see. Set it to the exact SSID to pin one unit.
target_ssid =
main_ip = 192.168.4.1
