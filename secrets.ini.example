; Copy this file to secrets.ini (git-ignored) and fill in real values.
;   cp secrets.ini.example secrets.ini
;
; secrets.ini overrides the [wifi] placeholders in platformio.ini via
; `extra_configs`. Values are injected as compile-time defines
; (CFG_WIFI_SSID, CFG_WIFI_PASS, CFG_WIFI_AP_SSID, CFG_WIFI_AP_PASS).
;
; Do NOT commit secrets.ini.

[wifi]
; 2.4 GHz network the D1 Mini joins (station mode).
sta_ssid = your-2g4-network
sta_pass = your-wifi-password

; The device's own access point. ap_pass must be >= 8 chars (WPA2),
; or empty for an open AP (not recommended).
ap_ssid = cc1101-setup
ap_pass = pick-a-strong-passphrase
